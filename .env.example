# The Odds API - https://the-odds-api.com (free tier: 500 requests/month)
ODDS_API_KEY=your_odds_api_key_here

# OpenWeatherMap - https://openweathermap.org/api (free tier: 60 calls/min)
WEATHER_API_KEY=your_openweathermap_key_here

# Twilio SMS - https://twilio.com (free trial ~$15 credit)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_TO_NUMBER=+1xxxxxxxxxx

# Database path (defaults to ./data/betting.db)
DB_PATH=./data/betting.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Bankroll for Kelly Criterion sizing (in dollars)
BANKROLL=1000

# Max bet percentage of bankroll (0.0 - 1.0)
MAX_BET_PCT=0.05

# Minimum edge required to flag a bet (as decimal, e.g. 0.03 = 3%)
MIN_EDGE=0.03

# Daily text time (24hr format, e.g. 10:00 = 10am)
DAILY_TEXT_TIME=10:00
