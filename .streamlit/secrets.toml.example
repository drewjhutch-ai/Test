# Copy this structure into Streamlit Cloud → App Settings → Secrets
# Do NOT commit the real secrets.toml file — only this example

# IMPORTANT — Database persistence on Streamlit Cloud:
# Streamlit Cloud has an ephemeral filesystem — the DB resets on every deploy.
# Set DB_PATH to a path on a persistent volume or leave blank to use the
# default (data/betting.db inside the repo folder).
# If running locally or on a VPS, leave this blank — data persists automatically.
# DB_PATH = "/mount/persist/betting.db"   # e.g. a Railway/Render mounted volume

ODDS_API_KEY = "your_odds_api_key_here"
WEATHER_API_KEY = "your_openweathermap_key_here"
TWILIO_ACCOUNT_SID = "your_twilio_sid_here"
TWILIO_AUTH_TOKEN = "your_twilio_token_here"
TWILIO_FROM_NUMBER = "+1xxxxxxxxxx"
TWILIO_TO_NUMBER = "+1xxxxxxxxxx"
BANKROLL = "1000"
MIN_EDGE = "0.03"
MAX_BET_PCT = "0.05"
DAILY_TEXT_TIME = "10:00"
